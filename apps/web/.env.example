# Web app environment variables (copy to `.env.local` for local overrides)

# Base URL of the API. Leave empty to use the same origin (recommended):
# - `vite dev` / `vite preview` proxy /api, /health, /swagger-ui and /api-docs
#   to VITE_API_PROXY_TARGET
# - the production static server proxies the same prefixes to API_UPSTREAM
VITE_API_BASE_URL=

# Dev server proxy target (server side only, not exposed to the browser)
VITE_API_PROXY_TARGET=http://localhost:8080

# Display name used in the UI
VITE_APP_NAME=CNGOKZAPI

# Swagger UI path served by the API
VITE_API_DOCS_PATH=/swagger-ui

# Dev server port
WEB_PORT=5173
