# Public portal environment (copy to `.env.local` for local overrides)

# Same-origin by default: dev server proxies /api, /health, /swagger-ui, /api-docs
VITE_API_BASE_URL=

# Dev/prod proxy target for the API
VITE_API_PROXY_TARGET=http://localhost:8080

# Public portal port (admin is served under /admin on the same port)
PORTAL_PORT=5173

# Admin dev server origin used by the /admin dev proxy
ADMIN_DEV_ORIGIN=http://127.0.0.1:5174

# Canonical site URL (SEO metadata + sitemap)
VITE_SITE_URL=http://localhost:5173
