# ============================================================================
# CNGOKZAPI - Environment variables (example)
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit real credentials. This file only contains local defaults.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_VERSION=0.1.0

# Tracing filter, e.g. info, debug, cngokz_api=debug,tower_http=debug
LOG_LEVEL=info

# Comma separated list of allowed browser origins. Use `*` only in local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timeout (milliseconds) for a single dependency health check
HEALTH_CHECK_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Local development (docker compose publishes 5432 on localhost by default)
DATABASE_URL=postgres://cngokz:cngokz@localhost:5432/cngokzapi
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
# Seconds to wait for a connection from the pool
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# Used by docker compose to bootstrap the postgres container.
# Use different, strong credentials in production.
POSTGRES_USER=cngokz
POSTGRES_PASSWORD=cngokz
POSTGRES_DB=cngokzapi
# Host port that is bound by docker compose (127.0.0.1 only by default)
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Optional namespace prefix reserved for future cache keys
REDIS_KEY_PREFIX=cngokz

# ---------------------------------------------------------------------------
# Docker compose / web
# ---------------------------------------------------------------------------
# Port that the web container publishes on the host
WEB_PORT=5173
# Port that the api container publishes on the host
API_PORT=8080
