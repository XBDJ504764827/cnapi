# ============================================================================
# CNGOKZAPI - Environment variables (example)
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit real credentials. This file only contains local defaults.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_VERSION=0.1.0

# Tracing filter, e.g. info, debug, cngokz_api=debug,tower_http=debug
LOG_LEVEL=info

# Comma separated list of allowed browser origins. Use `*` only in local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timeout (milliseconds) for a single dependency health check
HEALTH_CHECK_TIMEOUT_MS=2000
# Public API per-IP request limit (per minute)
PUBLIC_RATE_LIMIT_PER_MINUTE=120
# Cache maintenance token; leave empty to disable the protected endpoints
MAINTENANCE_TOKEN=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Local PostgreSQL / Redis (native services or the existing Docker containers)
DATABASE_URL=postgres://cngokz:cngokz@127.0.0.1:5432/cngokzapi
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
# Seconds to wait for a connection from the pool
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/3
# Optional namespace prefix reserved for future cache keys
REDIS_KEY_PREFIX=cngokz

# ---------------------------------------------------------------------------
# Frontend development
# ---------------------------------------------------------------------------
# Public portal dev server port
PORTAL_PORT=5173
# Admin dev server port (internal during development only)
ADMIN_PORT=5174
# Canonical public URL (SEO metadata + sitemap at build time)
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication (Steam OpenID 2.0 — the only login option)
# ---------------------------------------------------------------------------
# Origin the browser uses for this site. Used for the OpenID `realm`,
# `return_to` and for redirecting back after login. Production must be https.
PUBLIC_BASE_URL=http://localhost:5173
# Server side OpenID verification endpoint (in production this may be a
# Cloudflare Worker relay, see docs/authentication.md).
STEAM_OPENID_ENDPOINT=https://steamcommunity.com/openid/login
# Browser redirect target. Leave empty to reuse STEAM_OPENID_ENDPOINT; set it
# when the browser can reach Steam but the server cannot.
# STEAM_OPENID_BROWSER_ENDPOINT=
# Expected `openid.op_endpoint` in the returned assertion (Steam's own URL even
# when the round trip goes through a relay).
STEAM_OPENID_OP_ENDPOINT=https://steamcommunity.com/openid/login
STEAM_OPENID_CLAIMED_ID_PREFIX=https://steamcommunity.com/openid/id/
# Optional Steam Web API key: refreshes persona name and avatar on login.
# Without it the login still works and the UI falls back to `Player xxxx`.
STEAM_API_KEY=
# May also point at a relay when the server cannot reach the Steam Web API.
STEAM_API_BASE_URL=https://api.steampowered.com
# Session cookie. Secure defaults to `true` when APP_ENV=production.
SESSION_COOKIE_NAME=cngokz_session
SESSION_TTL_HOURS=720
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=
# SteamID64s automatically granted the `admin` role when they log in.
# Used to bootstrap the first administrator; comma separated.
ADMIN_STEAM_IDS=

# ---------------------------------------------------------------------------
# Phase 8 external data sources
# ---------------------------------------------------------------------------
# kzgo.eu maps/tiers/WRs/servers (live-verified)
KZGO_BASE_URL=https://kzgo.eu
KZGO_SYNC_ENABLED=true
# GOKZ-Global is the public KZTimerGlobal GlobalAPI v2 endpoint.
# Disabled by default until the deployment network can reach it and the
# operator confirms third-party usage.
GOKZ_GLOBAL_BASE_URL=https://kztimerglobal.com/api/v2.0
GOKZ_GLOBAL_SYNC_ENABLED=false
SOURCE_SYNC_INTERVAL_SECS=300
SOURCE_HTTP_TIMEOUT_MS=15000
# Public reads use external snapshots only while they are this fresh.
SOURCE_FALLBACK_MAX_AGE_SECS=900
