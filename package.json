{
  "name": "cngokzapi",
  "version": "0.1.0",
  "private": true,
  "description": "CNGOKZAPI - API and management platform for the CS:GO / CS2 KZ community",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cngokz/web --filter @cngokz/public dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:openapi": "pnpm --filter @cngokz/api-client gen:openapi && pnpm --filter @cngokz/shared-types gen:api",
    "gen:api-types": "pnpm --filter @cngokz/shared-types gen:api",
    "dev:admin": "pnpm --filter @cngokz/web dev",
    "dev:public": "pnpm --filter @cngokz/public dev",
    "build:admin": "pnpm --filter @cngokz/web build",
    "build:public": "pnpm --filter @cngokz/public build"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
