# ============================================================================
# CNGOKZAPI native production environment
#
#   cp .env.production.example /mnt/1panel/apps/openresty/openresty/www/sites/test.cngokz.com/index/cnapi/.env
#   chmod 600 /mnt/1panel/apps/openresty/openresty/www/sites/test.cngokz.com/index/cnapi/.env
#   # edit DB/Redis credentials
#   systemctl restart cngokz-api
# ============================================================================

APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=28080
APP_VERSION=0.1.0
LOG_LEVEL=info

# Public site is served by Nginx from /mnt/1panel/apps/openresty/openresty/www/sites/test.cngokz.com/index/cnapi (unified frontend) or the configured
# static root). The API listens only on loopback.
CORS_ALLOWED_ORIGINS=
PUBLIC_RATE_LIMIT_PER_MINUTE=120
HEALTH_CHECK_TIMEOUT_MS=2000

# Protected admin API token.
# Generate with: openssl rand -hex 32
MAINTENANCE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Authentication (Steam OpenID 2.0)
#
# The production host usually cannot reach steamcommunity.com. Deploy the
# relay in deploy/cloudflare/steam-openid-relay.js and point the server side
# endpoint at it; see docs/authentication.md section 8.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://test.cngokz.com
# Server side verification (Cloudflare relay recommended in production).
STEAM_OPENID_ENDPOINT=https://REPLACE_ME_STEAM_RELAY.workers.dev/openid/login
# Browser redirect target. Leave empty when the browser can reach Steam
# directly (recommended); set it to the relay for a full relay setup.
# STEAM_OPENID_BROWSER_ENDPOINT=
# Must stay Steam's own endpoint even when verification goes through a relay.
STEAM_OPENID_OP_ENDPOINT=https://steamcommunity.com/openid/login
STEAM_OPENID_CLAIMED_ID_PREFIX=https://steamcommunity.com/openid/id/
# Optional but recommended: persona name + avatar on login.
STEAM_API_KEY=
STEAM_API_BASE_URL=https://api.steampowered.com
SESSION_COOKIE_NAME=cngokz_session
SESSION_TTL_HOURS=720
# Keep true in production: the cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=
# Bootstrap administrators; comma separated SteamID64 values.
ADMIN_STEAM_IDS=

# ---------------------------------------------------------------------------
# Existing PostgreSQL / Redis
#
# Native backend runs on the host, so use 127.0.0.1 (not a Docker container
# name). Your existing containers publish 5432/6379 on the host.
# URL-encode special characters in the password.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://cngokz:DB_PASSWORD@127.0.0.1:5432/cngokzapi
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# Use a dedicated Redis DB index if the instance is shared.
REDIS_URL=redis://127.0.0.1:6379/3
REDIS_KEY_PREFIX=cngokz

# ---------------------------------------------------------------------------
# Phase 8 external data sources
# ---------------------------------------------------------------------------
KZGO_BASE_URL=https://kzgo.eu
KZGO_SYNC_ENABLED=true
GOKZ_GLOBAL_BASE_URL=https://kztimerglobal.com/api/v2.0
GOKZ_GLOBAL_SYNC_ENABLED=false
SOURCE_SYNC_INTERVAL_SECS=300
SOURCE_HTTP_TIMEOUT_MS=15000
SOURCE_FALLBACK_MAX_AGE_SECS=900
