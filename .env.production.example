# ============================================================================
# CNGOKZAPI native production environment
#
#   cp .env.production.example /mnt/1panel/apps/cnapi/.env
#   chmod 600 /mnt/1panel/apps/cnapi/.env
#   # edit DB/Redis credentials
#   systemctl restart cngokz-api
# ============================================================================

APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8080
APP_VERSION=0.1.0
LOG_LEVEL=info

# Public site is served by Nginx from /var/www/cngokzapi (or the configured
# static root). The API listens only on loopback.
CORS_ALLOWED_ORIGINS=
PUBLIC_RATE_LIMIT_PER_MINUTE=120
HEALTH_CHECK_TIMEOUT_MS=2000

# Protected admin API token.
# Generate with: openssl rand -hex 32
MAINTENANCE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Existing PostgreSQL / Redis
#
# Native backend runs on the host, so use 127.0.0.1 (not a Docker container
# name). Your existing containers publish 5432/6379 on the host.
# URL-encode special characters in the password.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://cngokz:DB_PASSWORD@127.0.0.1:5432/cngokzapi
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# Use a dedicated Redis DB index if the instance is shared.
REDIS_URL=redis://127.0.0.1:6379/3
REDIS_KEY_PREFIX=cngokz

# ---------------------------------------------------------------------------
# Phase 8 external data sources
# ---------------------------------------------------------------------------
KZGO_BASE_URL=https://kzgo.eu
KZGO_SYNC_ENABLED=true
GOKZ_GLOBAL_BASE_URL=https://kztimerglobal.com/api/v2.0
GOKZ_GLOBAL_SYNC_ENABLED=false
SOURCE_SYNC_INTERVAL_SECS=300
SOURCE_HTTP_TIMEOUT_MS=15000
SOURCE_FALLBACK_MAX_AGE_SECS=900
