[Unit]
Description=CNGOKZAPI backend (cngokz-api)
Documentation=https://github.com/XBDJ504764827/cnapi
Wants=network-online.target
After=network-online.target
# If PostgreSQL/Redis are installed as native services, uncomment:
# After=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/mnt/1panel/apps/cnapi
ExecStart=/mnt/1panel/apps/cnapi/bin/cngokz-api
# dotenvy loads /mnt/1panel/apps/cnapi/.env from WorkingDirectory.
Environment=RUST_LOG=info

Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=mixed

LimitNOFILE=65535
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cngokz-api

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
